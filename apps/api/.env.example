# Copier ce fichier en `.env` puis remplacer les valeurs. Le fichier `.env` n'est jamais commité.
NODE_ENV=development
PORT=3000

# Base PostgreSQL du docker-compose de développement
DATABASE_URL="postgresql://hurden:hurden_dev_only@127.0.0.1:5432/hurden?schema=public"

# Secret de signature des jetons d'accès : 32 caractères aléatoires minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Origines web autorisées (séparées par des virgules), jamais "*"
CORS_ORIGINS=http://localhost:8081

# --- Connexion Google / LinkedIn (facultatif : sans ces clés, les boutons sont désactivés) ---
# URL publique de l'API et de l'application web
API_PUBLIC_URL=http://127.0.0.1:3000
WEB_APP_URL=http://localhost:8081
# Adresse de retour à déclarer chez chaque fournisseur :
#   <API_PUBLIC_URL>/api/v1/auth/oauth/google/callback
#   <API_PUBLIC_URL>/api/v1/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

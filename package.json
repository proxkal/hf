{
  "name": "hurden",
  "private": true,
  "description": "HURDEN — Agir pour Réussir ! Application mobile/web et API.",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:migrate": "npm --prefix apps/api run db:migrate",
    "api:seed": "npm --prefix apps/api run db:seed",
    "api:test": "npm --prefix apps/api test",
    "app:web": "npm --prefix apps/mobile run web",
    "app:start": "npm --prefix apps/mobile start"
  }
}
